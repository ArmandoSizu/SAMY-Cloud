# =============================================================================
# SAMY Cloud - Plantilla de variables de entorno
# =============================================================================
#
#   cp .env.example .env
#
# NUNCA subas .env al repositorio. Este archivo (.env.example) SI se versiona
# y solo contiene valores de ejemplo o vacios: es la documentacion viva de
# que necesita el sistema para arrancar.
#
# Genera los secretos con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# -----------------------------------------------------------------------------
# IMPORTANTE al cambiar cualquier valor de .env
# -----------------------------------------------------------------------------
# "docker compose restart <servicio>" NO vuelve a leer este archivo: reinicia
# el proceso dentro del contenedor, pero el contenedor conserva el entorno con
# el que fue creado. El sintoma es desconcertante: las credenciales estan en
# .env y el servicio sigue diciendo que faltan.
#
# Para que los cambios surtan efecto hay que RECREAR el contenedor:
#
#   docker compose up -d --force-recreate --no-deps payments topups \
#       payments-worker topups-worker
#
# (los workers tambien: leen las mismas credenciales).
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# ENVIRONMENT decide contra que puede operar el sistema, y se aplica de verdad:
# ensure_ready() rechaza la operacion si el modo del proveedor no corresponde.
#
#     ENVIRONMENT=production   <->  proveedores en modo PRODUCTION
#     cualquier otro ambiente  <->  proveedores en modo SANDBOX
#
# Validos: development, dev, local, test, testing, ci, staging, stage,
# production, prod. Cualquier otra cosa (incluido "produccion" en espanol) se
# RECHAZA: un servicio que no sabe en que ambiente esta no mueve dinero.
#
# Las dos combinaciones prohibidas son las que arruinan lanzamientos:
#   produccion + sandbox -> se cobra de verdad y no se entrega nada;
#   pruebas + produccion -> se gasta saldo real y se recargan telefonos reales.
ENVIRONMENT=development
SERVICE_VERSION=0.1.0

# Aplica la CSP de produccion DE VERDAD en desarrollo, en vez de solo reportar.
#
# Existe porque el modo solo reporte no basta: avisa de lo que produccion
# bloquearia, pero la pantalla sigue funcionando, asi que nadie ve el sintoma.
# Con esto en True se descubrio que Alpine.js queda MUERTO bajo la CSP real
# (evalua sus expresiones con new Function() y script-src no lleva
# 'unsafe-eval'): la pantalla se pinta completa y los botones no hacen nada.
#
# Conviene dejarlo en True mientras haya plantillas con directivas de Alpine
# sin migrar. Ver docs/readiness-produccion.md.
CSP_ENFORCE=True
LOG_LEVEL=DEBUG
LOG_JSON=False

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# Obligatorio. Sin valor por defecto a proposito: el servicio no arranca sin el.
DJANGO_SECRET_KEY=cambia-esto-por-un-valor-generado-de-64-caracteres
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,core,proxy
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Ruta del admin de Django. Cambiala en produccion.
DJANGO_ADMIN_PATH=admin-samy/

# 8 horas = un turno de caja.
SESSION_COOKIE_AGE=28800
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Superusuario del contenedor de Postgres (solo desarrollo).
POSTGRES_SUPERUSER=samy
POSTGRES_SUPERUSER_PASSWORD=cambia-esta-clave-en-tu-env

# Contrasenas por servicio. El script de inicializacion crea un usuario por
# base, de modo que ningun servicio pueda leer las tablas de otro.
CORE_DB_PASSWORD=core_dev_password
PAYMENTS_DB_PASSWORD=payments_dev_password
TOPUPS_DB_PASSWORD=topups_dev_password
BILLPAY_DB_PASSWORD=billpay_dev_password

# Cadenas de conexion. Cada servicio recibe SOLO la suya.
CORE_DATABASE_URL=postgres://samy_core:core_dev_password@postgres:5432/samy_core
PAYMENTS_DATABASE_URL=postgres://samy_payments:payments_dev_password@postgres:5432/samy_payments
TOPUPS_DATABASE_URL=postgres://samy_topups:topups_dev_password@postgres:5432/samy_topups
BILLPAY_DATABASE_URL=postgres://samy_billpay:billpay_dev_password@postgres:5432/samy_billpay

DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
EVENT_STREAM_URL=redis://redis:6379/3

# -----------------------------------------------------------------------------
# Comunicacion entre microservicios (HMAC)
# -----------------------------------------------------------------------------
# Secreto compartido que firma todas las peticiones internas. Debe ser
# IDENTICO en los cuatro servicios y distinto en cada entorno.
SERVICE_S2S_SECRET=genera-un-secreto-largo-y-unico-para-s2s

PAYMENTS_SERVICE_URL=http://payments:8000
TOPUPS_SERVICE_URL=http://topups:8000
BILLPAY_SERVICE_URL=http://billpay:8000

SERVICE_TIMEOUT_CONNECT=3.0
SERVICE_TIMEOUT_READ=15.0

# -----------------------------------------------------------------------------
# Reglas de negocio
# -----------------------------------------------------------------------------
# Vigencia del QR/token de cobro, en segundos. Rango permitido: 180-300.
QR_TOKEN_TTL_SECONDS=240

# =============================================================================
# PROVEEDORES EXTERNOS
# =============================================================================
#
# ESTADO ACTUAL: ninguna integracion tiene credenciales.
#
# Mientras estas variables esten vacias, el adaptador correspondiente reporta
# NOT_CONFIGURED y RECHAZA operar. El sistema NO devuelve resultados simulados:
# la UI muestra "Integracion pendiente de credenciales" y no se cobra nada.
#
# Ver docs/api-integrations.md para el detalle de que hay que contratar,
# con quien, y que se necesita para activarlo.
# =============================================================================

# --- PAGOS: Conekta ----------------------------------------------------------
# Sandbox de auto-servicio: SI. Puedes obtener llaves hoy, sin contrato.
#
#   1. Crea cuenta en https://panel.conekta.com
#   2. Activa "Modo Pruebas" en el menu lateral (aparece un liston de aviso)
#   3. Developers -> API Keys: copia la llave PRIVADA y la PUBLICA
#      OJO: la privada solo se muestra UNA vez al generarla.
#   4. Obten la llave publica de webhooks (es DISTINTA de la publica de API):
#        curl -X POST https://api.conekta.io/webhook_keys \
#          -H "Authorization: Bearer TU_LLAVE_PRIVADA" \
#          -H "Accept: application/vnd.conekta-v2.3.0+json"
#      Copia el campo "public_key" COMPLETO, con las lineas
#      -----BEGIN PUBLIC KEY----- y -----END PUBLIC KEY-----.
#   5. Configura el webhook a: https://TU-DOMINIO/api/v1/webhooks/conekta/
#      En desarrollo hace falta exponer el puerto (ngrok o similar): Conekta
#      no puede alcanzar localhost.
#
# Notas que cuestan tiempo si no se saben:
#   - Prueba y produccion usan el MISMO dominio y el MISMO prefijo de llave.
#     Lo unico que distingue el ambiente es el campo "livemode" de la
#     respuesta; SAMY Cloud lo comprueba y se detiene si no coincide con
#     CONEKTA_MODE.
#   - Conekta NO tiene cabecera de idempotencia. La proteccion contra doble
#     cobro es nuestra.
# Firma de webhook: RSA-SHA256, cabecera "digest". Version de API: 2.3.0.
CONEKTA_MODE=SANDBOX
CONEKTA_PRIVATE_KEY=
CONEKTA_PUBLIC_KEY=
CONEKTA_WEBHOOK_PUBLIC_KEY=

# --- PAGOS: efectivo en mostrador --------------------------------------------
# No requiere proveedor externo: el cajero recibe el efectivo y lo confirma.
# Es un metodo de pago REAL con arqueo y auditoria, no una simulacion.
CASH_PAYMENT_ENABLED=True

# --- RECARGAS: Reloadly ------------------------------------------------------
# Sandbox de auto-servicio: SI, gratuito y con 1000 USD de saldo de prueba ya
# cargados por Reloadly al crear la cuenta.
#
#   1. Crea cuenta en https://www.reloadly.com
#   2. Activa el interruptor Live/Sandbox de la barra lateral y ponlo en
#      SANDBOX. Las credenciales son DISTINTAS en cada ambiente y un token de
#      uno no sirve en el otro.
#   3. Developers -> API Settings: copia Client ID y Client Secret
#
# Auth: OAuth2 client_credentials contra https://auth.reloadly.com/oauth/token
# con audience = https://topups-sandbox.reloadly.com (produccion:
# https://topups.reloadly.com). El token dura 24 h en sandbox y 60 dias en
# produccion; SAMY Cloud lo comparte entre procesos via Redis para no pedir
# uno por peticion: Reloadly SUSPENDE cuentas por exceso de llamadas y
# reactivarlas exige escribir a soporte.
#
# Notas que cuestan tiempo si no se saben:
#   - El catalogo se vende en MXN usando "localFixedAmounts", no
#     "fixedAmounts" (que vienen en la moneda del monedero, USD en sandbox).
#   - "customIdentifier" NO es una clave de idempotencia: Reloadly no promete
#     deduplicar por ella. Por eso nunca se reintenta una recarga a ciegas.
RELOADLY_MODE=SANDBOX
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=

# --- RECARGAS: TAECEL (produccion en Mexico) ---------------------------------
# ESTADO: cuenta REGISTRADA y activa. Acceso API PENDIENTE (levantamiento
# tecnologico a cc@taecel.com). Ver docs/readiness-produccion.md.
#
# TAECEL no publica su documentacion: la entrega junto con las credenciales de
# prueba. Por eso TAECEL_BASE_URL no tiene valor de ejemplo — no hay ninguno
# que sea real, y uno inventado apuntaria a un servidor que no es de TAECEL.
#
# El adaptador necesita TRES cosas para operar, y le falta cualquiera => no
# opera (reporta PENDING_CONTRACT y toda recarga se detiene antes de la red):
#   1. TAECEL_BASE_URL
#   2. TAECEL_KEY + TAECEL_NIP
#   3. TAECEL_CONTRACT_VERIFIED=True
#
# La tercera es una FIRMA HUMANA, no un interruptor de conveniencia: significa
# "lei el manual que mando TAECEL y confirme que las rutas y los campos del
# adaptador coinciden con el". Ponerla en True sin haber leido el manual es
# exactamente el error que esta variable existe para evitar.

# SANDBOX o PRODUCTION. TAECEL_ENV es el nombre canonico; TAECEL_MODE queda
# como alias historico. Si pones los dos con valores distintos, el servicio NO
# arranca: preferimos un arranque fallido a un servicio que adivina si esta en
# produccion.
TAECEL_ENV=SANDBOX
TAECEL_BASE_URL=
TAECEL_KEY=
TAECEL_NIP=
TAECEL_CONTRACT_VERIFIED=False

# Rutas de operacion. Las dos primeras traen un valor por omision en el codigo
# que NO esta confirmado contra documentacion de TAECEL; las dos ultimas no
# traen ninguno porque no se conoce su nombre, y sin la de saldo el adaptador
# se niega a vender (TAECEL es prepago: vender sin saber el saldo puede dejar
# una orden ya pagada sin recarga). Se rellenan desde su manual.
TAECEL_PATH_REQUEST_TXN=RequestTXN
TAECEL_PATH_STATUS_TXN=StatusTXN
TAECEL_PATH_BALANCE=
TAECEL_PATH_PRODUCTS=

# --- RECARGAS: LINNTAE (DEMO) ------------------------------------------------
# ESTADO: integracion DEMO. **No hay produccion certificada.**
# Documentacion: docs/providers/linntae.md
#
# A diferencia de TAECEL, Linntae SI publica su especificacion OpenAPI, asi
# que las rutas y los campos de su adaptador no son suposiciones. Lo que sigue
# sin conocerse esta listado en su documento y esta protegido por
# configuracion, no por buena voluntad.
#
# CUATRO condiciones para que pueda mover saldo, y falta una => no opera:
#   1. LINNTAE_ENV coherente con LINNTAE_BASE_URL
#   2. LINNTAE_USERNAME + LINNTAE_PASSWORD
#   3. LINNTAE_TYPE_BALANCE confirmado con Linntae
#   4. LINNTAE_ENABLED=true Y ALLOW_REAL_PROVIDER_TRANSACTIONS=true

# demo o production ('sandbox' y 'prod' se aceptan como sinonimos). Un valor
# fuera de esos cuatro impide el arranque del servicio: un error de dedo aqui
# es la diferencia entre una recarga de prueba y una real.
#
# La guarda de host no es negociable: 'demo' solo puede hablar con
# apidemo.linn.mx y 'production' solo con api.linn.mx. Cruzarlos es la forma
# mas directa de mandar una recarga real creyendo que es de prueba, y el
# adaptador se niega antes de abrir la conexion.
LINNTAE_ENV=demo
LINNTAE_BASE_URL=https://apidemo.linn.mx/api/v1/

# Credenciales. Se ponen aqui y en ningun otro sitio: no van al repositorio,
# ni a la imagen de Docker, ni a los logs, ni al frontend. El navegador jamas
# habla con Linntae; solo el backend.
LINNTAE_USERNAME=
LINNTAE_PASSWORD=

# Vacio a proposito, y eso BLOQUEA la venta.
#
# Linntae exige 'typeBalance' como entero obligatorio en cada compra pero NO
# publica su enumeracion. Que 1 sea "SALDO PLATAFORMA" es una inferencia de
# sus ejemplos, no un dato. Mandar el numero equivocado gasta la bolsa
# equivocada, asi que se pone cuando Linntae lo confirme por escrito.
LINNTAE_TYPE_BALANCE=

# 'extraComision' es lo que Linntae suma al cobro del cliente en SU punto de
# venta. En SAMY el cobro al cliente lo calcula el motor de precios de SAMY,
# asi que aqui va CERO. Su especificacion admite 0..5 para tiempo aire; un
# valor distinto cambia lo que se carga a la bolsa de plataforma de una forma
# que su documento no detalla, y eso no se activa sin haberlo medido en DEMO.
LINNTAE_EXTRA_COMISION=0

# Vida del token en nuestra cache, en segundos. Linntae NO publica la vida
# real del token, asi que este numero es NUESTRO y es corto a proposito: el
# token tambien se invalida por evidencia cuando responden 401.
LINNTAE_TOKEN_TTL_SECONDS=600
LINNTAE_CONNECT_TIMEOUT=5.0
LINNTAE_READ_TIMEOUT=30.0
LINNTAE_REINTENTOS_LECTURA=2

# COMO aplica Linntae su comision. Valores: SIN_DETERMINAR,
# DESCUENTO_POR_TRANSACCION, BONO_AL_FONDEAR, COMISION_ACREDITADA_APARTE.
#
# SIN_DETERMINAR por omision, y es lo correcto hoy. Su esquema se llama
# "COMISION SOBRE VENTA" y su consulta de saldo devuelve 'plataforma' y
# 'comision' como bolsas separadas, lo que APUNTA a que el saldo se descuenta
# al valor facial y la comision se abona aparte. Apuntar no es saber: el mismo
# 6% da tres costos distintos segun el mecanismo. Con SIN_DETERMINAR el motor
# de precios reporta "margen desconocido" en vez de afirmar un numero que
# nadie comprobo.
#
# Se resuelve MIDIENDO, no leyendo: saldo antes y despues de una recarga DEMO.
LINNTAE_COMMISSION_MECHANISM=SIN_DETERMINAR

# Deja a Linntae configurado y visible en el panel de plataforma sin
# autorizarlo a gastar. Es distinto de la bandera de abajo a proposito.
LINNTAE_ENABLED=false

# --- INTERRUPTOR FINAL DE OPERACIONES REALES ---------------------------------
# Vale para CUALQUIER proveedor. Mientras sea false, ninguna llamada que mueva
# saldo sale de SAMY: se levanta ProviderNotConfigured antes del envio.
#
# Es independiente de DEBUG y de ENVIRONMENT a proposito. DEBUG contesta
# "estoy depurando" y ENVIRONMENT contesta "en que ambiente corro"; ninguna de
# las dos preguntas es "tengo autorizacion para gastar dinero".
ALLOW_REAL_PROVIDER_TRANSACTIONS=false

# Proveedores a los que se les mide el saldo antes y despues de cada recarga.
# Es la medicion que permite deducir el mecanismo de comision de un proveedor
# nuevo en vez de suponerlo. Cuesta dos llamadas por recarga, asi que se
# decide por lista: Reloadly suspende cuentas por exceso de llamadas y ahi no
# hace falta. Se saca el slug de la lista cuando el mecanismo ya este medido.
TOPUP_MEDIR_SALDO_PROVIDERS=linntae

# --- GUARDA DE SALDO DEL PROVEEDOR -------------------------------------------
# Se comprueba en create_fulfillment, ANTES de que exista la orden, porque ese
# es el ultimo momento en que decir "no" no cuesta dinero. La secuencia que
# evita: cobrar $100 -> orden PAID -> "saldo insuficiente" -> el cliente ya
# pago y no tiene recarga.
#
# Un saldo insuficiente CONFIRMADO bloquea en cualquier ambiente. Un saldo que
# no se pudo verificar (el proveedor no lo dice, o lo dice en otra moneda que
# la venta) bloquea solo en produccion: en sandbox el dinero no es real.

# Segundos que se cachea el saldo. Corto a proposito: Reloadly suspende
# cuentas por exceso de llamadas, pero un saldo viejo deja pasar ventas con
# fondos que ya no existen. Segundos, no minutos.
TOPUP_SALDO_CACHE_SECONDS=30

# Colchon de saldo que NO se vende, en centavos. Vender hasta dejar el saldo
# en cero hace que la venta siguiente falle a mitad con la orden ya pagada;
# esta reserva tambien absorbe la ventana del cache.
#
# Cero por omision: el valor correcto depende del volumen del negocio y es una
# decision comercial, no un numero que el codigo deba inventar. Con el fondeo
# minimo de $5,000 que exige TAECEL, algo del orden de $50,000 centavos ($500)
# deja margen para una racha sin cortar la venta.
TOPUP_RESERVA_SALDO_CENTS=0

# --- PAGO DE SERVICIOS: agregador --------------------------------------------
# CFE y CAPDAM NO tienen API publica. Se opera forzosamente vía agregador
# autorizado, y todos requieren contrato comercial y fondeo prepagado.
# Candidatos investigados: tapi (developers.tapila.cloud), Taecel, Sivetel,
# Arcus (Mastercard).
# ESTADO: PENDIENTE DE CONTRATO.
BILLPAY_PROVIDER=none
TAPI_MODE=SANDBOX
TAPI_API_KEY=
TAPI_API_SECRET=

# =============================================================================
# Produccion (dejar vacio en desarrollo)
# =============================================================================
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@samycloud.mx

USE_OBJECT_STORAGE=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
