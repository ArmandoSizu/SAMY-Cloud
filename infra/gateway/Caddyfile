# =============================================================================
# SAMY Cloud - Proxy inverso (desarrollo)
# =============================================================================
#
# Unico punto de entrada. El navegador solo conoce este origen.
#
# Por que un proxy delante incluso en desarrollo:
#   - Reproduce la topologia de produccion (TLS terminado aqui, cabeceras
#     X-Forwarded-*). Si Django solo se prueba sin proxy, los bugs de
#     SECURE_PROXY_SSL_HEADER aparecen recien en produccion.
#   - Sirve los archivos estaticos sin pasar por Python.
#   - Deja el camino listo para HTTPS automatico: en produccion basta cambiar
#     ":8000" por el dominio y Caddy gestiona el certificado con Let's Encrypt.
# =============================================================================

{
	# En desarrollo no se emiten certificados.
	auto_https off
	admin off
}

:8000 {
	encode zstd gzip

	# Archivos estaticos servidos directamente por Caddy.
	handle_path /static/* {
		root * /srv/static
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# -------------------------------------------------------------------------
	# Webhook de Conekta
	# -------------------------------------------------------------------------
	# La UNICA ruta de un microservicio alcanzable desde fuera, y es
	# deliberado: un webhook no sirve de nada si el proveedor no puede
	# llegar a el.
	#
	# Se expone una RUTA, no un puerto: payments sigue sin publicar el suyo
	# y el resto de su API sigue siendo inalcanzable desde internet.
	#
	# Por que se enruta aqui y no con una vista intermedia en el Core: la
	# firma de Conekta es RSA sobre los BYTES EXACTOS del cuerpo. Un salto
	# extra que lea y vuelva a serializar el JSON cambiaria esos bytes y la
	# firma dejaria de validar. Caddy los pasa tal cual.
	#
	# La ruta publica es corta a proposito; internamente apunta al endpoint
	# real, /api/v1/webhooks/conekta/, que ya existia.
	handle /webhooks/conekta/* {
		rewrite * /api/v1/webhooks/conekta/
		reverse_proxy payments:8000 {
			# payments valida ALLOWED_HOSTS y no conoce el dominio del tunel,
			# que ademas cambia en cada arranque. Se le presenta un host que
			# si tiene permitido; el origen real viaja en X-Real-IP.
			header_up Host localhost
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Todo lo demas va al Core Platform. Los microservicios NO se exponen:
	# solo el Core habla con ellos, por la red interna y con peticiones
	# firmadas.
	handle {
		reverse_proxy core:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output stdout
		format console
	}
}
